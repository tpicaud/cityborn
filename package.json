{
  "name": "cityborn",
  "version": "1.0.0",
  "description": "Guess where your favorite stars were born",
  "private": true,
  "author": "Tom Picaud",
  "homepage": "https://github.com/tpicaud/cityborn#readme",
  "packageManager": "pnpm@10.12.3",
  "scripts": {
    "format": "prettier --write .",
    "format:frontend": "prettier --write packages/cityborn-frontend",
    "format:backend": "prettier --write packages/cityborn-backend",
    "format:back-office": "prettier --write packages/cityborn-back-office",
    "build": "turbo run build",
    "build:backend": "turbo run build --filter=cityborn-backend",
    "build:frontend": "turbo run build --filter=cityborn-frontend",
    "build:back-office": "turbo run build --filter=cityborn-back-office",
    "dev": "turbo run dev",
    "dev:backend": "turbo run dev --filter=cityborn-backend",
    "dev:frontend": "turbo run dev --filter=cityborn-frontend",
    "dev:back-office": "turbo run dev --filter=cityborn-back-office",
    "start": "turbo run start",
    "start:backend": "turbo run start --filter=cityborn-backend",
    "start:frontend": "turbo run start --filter=cityborn-frontend",
    "start:back-office": "turbo run start --filter=cityborn-back-office"
  },
  "pnpm": {
    "overrides": {
      "lightningcss": "1.30.1"
    }
  },
  "devDependencies": {
    "eslint-config-prettier": "^10.1.5",
    "prettier": "^3.6.2",
    "turbo": "^2.5.4"
  }
}
