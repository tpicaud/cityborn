{
  "name": "cityborn",
  "version": "1.0.0",
  "description": "Guess where your favorite stars were born",
  "private": true,
  "author": "Tom Picaud",
  "homepage": "https://github.com/tpicaud/cityborn#readme",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev:mobile": "turbo run dev --filter=cityborn-mobile... --filter=cityborn-back-office... --filter=cityborn-backend...",
    "dev:web": "turbo run dev --filter=cityborn-frontend... --filter=cityborn-back-office... --filter=cityborn-backend...",
    "backend": "pnpm --dir apps/backend",
    "build:backend": "turbo run build --filter=cityborn-backend",
    "dev:backend": "turbo run dev --filter=cityborn-backend...",
    "start:backend": "turbo run start --filter=cityborn-backend",
    "frontend": "pnpm --dir apps/frontend",
    "build:frontend": "turbo run build --filter=cityborn-frontend",
    "dev:frontend": "turbo run dev --filter=cityborn-frontend...",
    "back-office": "pnpm --dir apps/back-office",
    "build:back-office": "turbo run build --filter=cityborn-back-office",
    "dev:back-office": "turbo run dev --filter=cityborn-back-office...",
    "mobile": "pnpm --dir apps/mobile",
    "db:dev:start": "pnpm backend db:dev:start",
    "db:dev:stop": "pnpm backend db:dev:stop",
    "db:dev:up": "pnpm backend db:dev:up",
    "db:dev:migrate": "pnpm backend db:dev:migrate",
    "db:dev:reset": "pnpm backend db:dev:reset",
    "db:restore": "node --env-file-if-exists=apps/backend/.env.restore scripts/database-backup/restore.mts",
    "test:db-restore": "pnpm backend test:int --runTestsByPath test/integration/database-restore.integration.spec.ts",
    "check:agent-docs": "node scripts/check-agent-docs.mts",
    "check:axiom-dashboards": "node scripts/axiom-dashboards.mts check",
    "deploy:axiom-dashboards": "node scripts/axiom-dashboards.mts deploy",
    "check:api-compat": "pnpm --dir packages/api check:compat",
    "format": "biome check --write .",
    "lint": "biome check .",
    "db:test:start": "pnpm backend db:test:start",
    "db:test:stop": "pnpm backend db:test:stop",
    "test:int": "pnpm backend test:int",
    "test:e2e": "pnpm backend test:e2e",
    "test:watch": "turbo run test:watch",
    "test:cov": "turbo run test:cov",
    "test:all": "turbo run test:all",
    "db:recette:start": "pnpm backend db:recette:start",
    "db:recette:stop": "pnpm backend db:recette:stop",
    "recette:prepare": "bash scripts/recette/launch.sh prepare",
    "recette:backend": "bash scripts/recette/launch.sh backend",
    "recette:frontend": "bash scripts/recette/launch.sh frontend",
    "recette:back-office": "bash scripts/recette/launch.sh back-office",
    "recette:captures": "bash scripts/recette/publish-captures.sh",
    "recette:web": "pnpm run \"/^recette:(backend|frontend|back-office)$/\"",
    "check": "pnpm typecheck && pnpm lint"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@vitejs/plugin-react": "^6.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^2.1.1",
    "turbo": "^2.10.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
