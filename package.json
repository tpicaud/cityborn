{
  "name": "cityborn",
  "version": "1.0.0",
  "description": "Guess where your favorite stars were born",
  "private": true,
  "author": "Tom Picaud",
  "homepage": "https://github.com/tpicaud/cityborn#readme",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck",
    "dev:mobile": "turbo run dev --filter=./apps/mobile --filter=./apps/backend",
    "dev:web": "turbo run dev --filter=./apps/back-office --filter=./apps/backend --filter=./apps/frontend",
    "packages:build": "turbo run build --filter=./packages/*",
    "backend": "pnpm --dir apps/backend",
    "backend:build": "turbo run build --filter=cityborn-backend",
    "backend:dev": "turbo run dev --filter=cityborn-backend",
    "backend:start": "turbo run start --filter=cityborn-backend",
    "backend:format": "pnpm --dir apps/backend format",
    "backend:check": "pnpm --dir apps/backend check",
    "frontend": "pnpm --dir apps/frontend",
    "frontend:build": "turbo run build --filter=cityborn-frontend",
    "frontend:dev": "turbo run dev --filter=cityborn-frontend",
    "frontend:start": "turbo run start --filter=cityborn-frontend",
    "frontend:format": "pnpm --dir apps/frontend format",
    "frontend:check": "pnpm --dir apps/frontend check",
    "back-office": "pnpm --dir apps/back-office",
    "back-office:build": "turbo run build --filter=cityborn-back-office",
    "back-office:dev": "turbo run dev --filter=cityborn-back-office",
    "back-office:start": "turbo run start --filter=cityborn-back-office",
    "back-office:format": "pnpm --dir apps/back-office format",
    "back-office:check": "pnpm --dir apps/back-office check",
    "mobile": "pnpm --dir apps/mobile",
    "mobile:prebuild": "pnpm mobile prebuild",
    "mobile:build-android": "pnpm mobile android",
    "mobile:build-ios": "pnpm mobile ios",
    "mobile:dev": "pnpm mobile dev",
    "mobile:start": "pnpm mobile start",
    "mobile:format": "pnpm --dir apps/mobile format",
    "mobile:check": "pnpm --dir apps/mobile check",
    "db:start": "cd apps/backend && pnpm db:start && cd ../..",
    "db:stop": "cd apps/backend && pnpm db:stop && cd ../..",
    "db:up": "pnpm backend db:up",
    "db:migrate": "pnpm backend db:migrate",
    "db:reset": "pnpm backend db:reset",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "format:fix": "biome check --write ."
  },
  "pnpm": {
    "overrides": {
      "typescript": "6.0.3",
      "lightningcss": "1.30.1",
      "@xmldom/xmldom@>=0.8.0 <0.8.4": ">=0.8.4",
      "tar@<7.5.7": ">=7.5.7",
      "tar@<=7.5.2": ">=7.5.3",
      "tar@<7.5.8": ">=7.5.8",
      "minimatch@<3.1.3": ">=3.1.3",
      "minimatch@<3.1.4": ">=3.1.4",
      "tar@<=7.5.9": ">=7.5.10",
      "tar@<=7.5.10": ">=7.5.11",
      "tar@<=7.5.3": ">=7.5.4",
      "@hono/node-server@<1.19.13": ">=1.19.13",
      "@xmldom/xmldom@<0.8.13": ">=0.8.13",
      "uuid@<14.0.0": ">=14.0.0",
      "postcss@<8.5.10": ">=8.5.10",
      "@xmldom/xmldom@<0.8.12": ">=0.8.12",
      "next@>=16.0.0 <16.2.5": ">=16.2.5",
      "next@>=16.0.0 <16.2.6": ">=16.2.6",
      "js-yaml@<=4.1.1": ">=4.2.0",
      "multer@>=1.0.0 <2.2.0": ">=2.2.0",
      "multer@>=2.0.0-alpha.1 <2.2.0": ">=2.2.0",
      "@react-native/codegen": "0.85.2"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "turbo": "^2.10.0",
    "typescript": "6.0.3"
  }
}
