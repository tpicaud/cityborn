{
  "name": "cityborn",
  "version": "1.0.0",
  "description": "Guess where your favorite stars were born",
  "private": true,
  "author": "Tom Picaud",
  "homepage": "https://github.com/tpicaud/cityborn#readme",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev:mobile": "turbo run dev --filter=cityborn-mobile... --filter=cityborn-back-office... --filter=cityborn-backend...",
    "dev:web": "turbo run dev --filter=cityborn-frontend... --filter=cityborn-back-office... --filter=cityborn-backend...",
    "backend": "pnpm --dir apps/backend",
    "backend:build": "turbo run build --filter=cityborn-backend",
    "backend:dev": "turbo run dev --filter=cityborn-backend...",
    "backend:start": "turbo run start --filter=cityborn-backend",
    "frontend": "pnpm --dir apps/frontend",
    "frontend:build": "turbo run build --filter=cityborn-frontend",
    "frontend:dev": "turbo run dev --filter=cityborn-frontend...",
    "back-office": "pnpm --dir apps/back-office",
    "back-office:build": "turbo run build --filter=cityborn-back-office",
    "back-office:dev": "turbo run dev --filter=cityborn-back-office...",
    "mobile": "pnpm --dir apps/mobile",
    "mobile:dev": "turbo run dev --filter=cityborn-mobile...",
    "db:start": "pnpm backend db:start",
    "db:stop": "pnpm backend db:stop",
    "db:up": "pnpm backend db:up",
    "db:migrate": "pnpm backend db:migrate",
    "db:reset": "pnpm backend db:reset",
    "db:restore": "node --env-file-if-exists=apps/backend/.env.restore scripts/database-backup/restore.mts",
    "db:restore:test": "pnpm backend test:int --runTestsByPath test/integration/database-restore.integration.spec.ts",
    "check:agent-docs": "node scripts/check-agent-docs.mts",
    "check:axiom-dashboards": "node scripts/axiom-dashboards.mts check",
    "deploy:axiom-dashboards": "node scripts/axiom-dashboards.mts deploy",
    "check:api-compat": "pnpm --dir packages/api check:compat",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "db:test:start": "pnpm backend db:test:start",
    "db:test:stop": "pnpm backend db:test:stop",
    "test:int": "pnpm backend test:int",
    "test:e2e": "pnpm backend test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "turbo": "^2.10.0",
    "typescript": "6.0.3"
  }
}
