# Copier dans apps/backend/.env.restore. Ne jamais versionner les identifiants.
# URL directe ou pooler en mode session, port 5432. Mot de passe encodé dans l'URL.
RESTORE_PRODUCTION_PROJECT_REF=
RESTORE_PRODUCTION_DB_URL=
RESTORE_PRODUCTION_SSL_ROOT_CERT=

# Facultatif : cible de staging pour les exercices de restauration.
RESTORE_STAGING_PROJECT_REF=
RESTORE_STAGING_DB_URL=
RESTORE_STAGING_SSL_ROOT_CERT=
