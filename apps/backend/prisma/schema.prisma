// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

////////////////////
// User & Profile //
////////////////////

enum UserRole {
  player
  admin
}

model User {
  passwordResetToken PasswordResetToken?
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String    @unique
  username   String    @unique
  type       String    @default("unknown")
  role       UserRole  @default(player)
  password   String?
  authVersion Int   @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime? @updatedAt
  isVerified Boolean   @default(false)
  appleId    String?

  tokens      EmailVerificationToken[]
  gameRecords GameRecord[]             @relation("GameRecordUsers")
}

model PasswordResetToken {
  userId String @id @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  expiresAt DateTime
}

model EmailVerificationToken {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token String @unique
  email String

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum GameMode {
  solo
  multi
}

model GameRecord {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mode            GameMode
  gameConfig      Json
  players         Json
  guessObjectsIds String[]
  results         Json
  createdAt       DateTime @default(now())

  users User[] @relation("GameRecordUsers")
}

//////////////////////////////////////////////
// Location/GuessObject/Packs/Themes models //
//////////////////////////////////////////////

model WorldLocation {
  id           String  @id @default(dbgenerated("gen_random_uuid()"))
  osm_type     String  @default("relation")
  external_id  String
  name         String
  display_name String
  addresstype  String?
  centroid     Float[]
  source       Json    @db.JsonB

  geometry     WorldLocationGeometry?
  guessObjects GuessObject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([osm_type, external_id])
}

model WorldLocationGeometry {
  id                String        @id @default(dbgenerated("gen_random_uuid()"))
  data              Json          @db.JsonB

  world_location_id String        @unique
  world_location    WorldLocation @relation(fields: [world_location_id], references: [id], onDelete: Cascade)
}

model GuessObject {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String  @unique
  image             String?
  description       String?
  short_description String?
  source            Json?   @db.JsonB

  world_location_id String
  world_location    WorldLocation @relation(fields: [world_location_id], references: [id])
  packs             Pack[]        @relation("PackGuessObjects")
}

model Theme {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String
  icon     Json
  position Int    @default(0)

  packs Pack[]
  catalogSections CatalogSection[]
}

model Pack {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  isPublished Boolean @default(false)
  description String?
  image       String?
  themeId     String  @default("244b803a-63aa-460a-a40d-4eea0ec2be50") @db.Uuid

  theme        Theme         @relation(fields: [themeId], references: [id])
  guessObjects GuessObject[] @relation("PackGuessObjects")

  catalogSections CatalogSectionPack[]

  @@index([themeId])
}

///////////////////////
// End game sentence //
///////////////////////
enum ScoreType {
  GOOD
  AVERAGE
  BAD
}

model EndGameSentence {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  message    String
  score_type ScoreType
}

//////////////
// Tracking //
//////////////

model Event {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  visitorId  String
  properties Json
  createdAt  DateTime @default(now()) @db.Timestamp(6)
}

model CatalogSection {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String
  themeId String? @db.Uuid
  position Int
  theme Theme? @relation(fields: [themeId], references: [id], onDelete: Cascade)
  packs CatalogSectionPack[]
  @@index([themeId, position])
}

model CatalogSectionPack {
  sectionId String @db.Uuid
  packId String @db.Uuid
  position Int
  section CatalogSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  pack Pack @relation(fields: [packId], references: [id], onDelete: Cascade)
  @@id([sectionId, packId])
  @@index([packId])
}
