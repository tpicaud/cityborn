// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

////////////////////
// User & Profile //
////////////////////

model User {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String    @unique
  username   String    @unique
  type       String    @default("unknown")
  password   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime? @updatedAt
  isVerified Boolean   @default(false)
  appleId    String?

  tokens      EmailVerificationToken[]
  gameRecords GameRecord[]             @relation("GameRecordUsers")
}

model EmailVerificationToken {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token String @unique

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum GameMode {
  solo
  multi
}

model GameRecord {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mode            GameMode
  gameConfig      Json
  players         Json
  guessObjectsIds String[]
  results         Json
  createdAt       DateTime @default(now())

  users User[] @relation("GameRecordUsers")
}

////////////////////////////////////////////
// Location/GuessObject/Categories models //
////////////////////////////////////////////

enum LocationType {
  area
  point
}

enum LocationLevel {
  ADM1
  ADM2
  ADM3
  ADM4
}

model WorldLocation {
  id           String         @id @default(dbgenerated("gen_random_uuid()"))
  osm_type     String         @default("relation")
  external_id  String
  name         String
  display_name String?
  addresstype  String?
  type         LocationType
  level        LocationLevel?
  iso_code     String?
  centroid     Float[]
  source       Json?          @db.JsonB

  geometry     WorldLocationGeometry?
  guessObjects GuessObject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([osm_type, external_id])
}

model WorldLocationGeometry {
  id                String        @id @default(dbgenerated("gen_random_uuid()"))
  data              Json          @db.JsonB

  world_location_id String        @unique
  world_location    WorldLocation @relation(fields: [world_location_id], references: [id], onDelete: Cascade)
}

model GuessObject {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String  @unique
  image             String?
  description       String?
  short_description String?
  source            Json?   @db.JsonB

  world_location_id String
  world_location    WorldLocation @relation(fields: [world_location_id], references: [id])
  categories        Category[]    @relation("CategoryGuessObjects")
}

model Category {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  isPublished Boolean @default(false)
  description String?
  parentId    String? @db.Uuid

  parent       Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children     Category[] @relation("CategoryChildren")
  guessObjects GuessObject[] @relation("CategoryGuessObjects")

  @@index([parentId])
}

///////////////////////
// End game sentence //
///////////////////////
enum ScoreType {
  GOOD
  AVERAGE
  BAD
}

model EndGameSentence {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  message    String
  score_type ScoreType
}

//////////////
// Tracking //
//////////////

model Event {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  visitorId  String
  properties Json
  createdAt  DateTime @default(now()) @db.Timestamp(6)
}
