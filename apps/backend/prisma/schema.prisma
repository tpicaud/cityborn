// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

////////////////////
// User & Profile //
////////////////////

model User {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String    @unique
  username   String    @unique
  birthdate  DateTime? @db.Date
  type       String    @default("unknown")
  password   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime? @updatedAt
  isVerified Boolean   @default(false)

  tokens      EmailVerificationToken[]
  gameRecords GameRecord[]             @relation("GameRecordUsers")
}

model EmailVerificationToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token     String   @unique

  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum GameMode {
  solo
  multi
}

model GameRecord {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mode            GameMode
  gameConfig      Json
  players         Json
  guessObjectsIds String[]
  results         Json
  createdAt       DateTime @default(now())

  users User[] @relation("GameRecordUsers")
}

////////////////////////////////////////////
// Location/GuessObject/Categories models //
////////////////////////////////////////////

enum LocationType {
  area
  point
}

enum LocationLevel {
  ADM1
  ADM2
  ADM3
  ADM4
}

model Location {
  id       String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String
  type     LocationType
  level    LocationLevel?
  iso_code String?
  centroid Float[]
  geometry Json           @db.JsonB
  source   Json?          @db.JsonB

  // parent relation
  parentId String?    @db.Uuid
  parent   Location?  @relation("ParentChild", fields: [parentId], references: [id])
  children Location[] @relation("ParentChild")

  guessObjects GuessObject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GuessObject {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  image             String?
  description       String?
  short_description String?

  world_location_id String     @db.Uuid
  world_location    Location   @relation(fields: [world_location_id], references: [id])
  categories        Category[] @relation("CategoryGuessObjects")
}

model Category {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?

  guessObjects GuessObject[] @relation("CategoryGuessObjects")
}

//////////////
// Tracking //
//////////////

model Event {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  visitorId  String
  properties Json
  createdAt  DateTime @default(now()) @db.Timestamp(6)
}
