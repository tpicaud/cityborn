# Optional runtime values with defaults
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=info

# Required auth values
JWT_ACCESS_SECRET=access_token_secret
JWT_REFRESH_SECRET=refresh_token_secret
GOOGLE_CLIENT_ID=
APP_ID=com.cityborn.app
ADMIN_DASHBOARD_TOKEN=token

# Required persistence values
REDIS_URL=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Optional Prisma CLI value with a local dummy default
DIRECT_URL=

# Required mail values
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Optional mail value with default
BREVO_SENDER_NAME=Cityborn

# Optional Axiom pair
AXIOM_TOKEN=
AXIOM_DATASET=
