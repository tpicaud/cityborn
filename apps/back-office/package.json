{
  "name": "cityborn-back-office",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "typecheck": "next typegen && tsc --noEmit",
    "dev": "pnpm check:env:development && dotenv -c development -- next dev",
    "build": "pnpm check:env:production && next build --turbopack",
    "check:env:development": "dotenv -c development -- node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON config/client.ts",
    "check:env:production": "dotenv -c production -- node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON config/client.ts",
    "format": "biome check --write .",
    "lint": "biome check .",
    "check": "pnpm typecheck && pnpm lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:all": "pnpm test"
  },
  "dependencies": {
    "@ariakit/react": "^0.4.26",
    "@cityborn/api": "workspace:*",
    "@cityborn/client": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.9.1",
    "@mui/material": "^9.0.0",
    "@tanstack/react-query": "^5.104.1",
    "@types/geojson": "^7946.0.16",
    "@types/google.maps": "^3.64.0",
    "@vis.gl/react-google-maps": "^1.8.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.11.0",
    "next": "16.4.1",
    "papaparse": "^5.5.3",
    "postcss": "^8.5.10",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-hook-form": "^7.86.0",
    "swagger-ui-react": "^5.34.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^25.6.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/swagger-ui-react": "^5.18.0",
    "@vitest/coverage-v8": "5.1.0",
    "dotenv-cli": "^11.0.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vitest": "5.1.0"
  }
}
