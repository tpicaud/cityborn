{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["node", "react"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": ["node_modules", "**/*.test.ts", "**/*.test.tsx", "test"]
}
