{
  "name": "cityborn-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "prebuild": "expo prebuild --clean",
    "build-android-development": "npx dotenv -e .env -- eas build --profile development --platform android --local --clear-cache --output app-builds/cityborn-development-preview.apk",
    "build-android-staging-preview": "npx dotenv -e .env.staging -- eas build --profile preview --platform android --local --clear-cache --output app-builds/cityborn-staging-preview.apk",
    "build-android-production-preview": "npx dotenv -e .env.production -- eas build --profile preview --platform android --local --clear-cache --output app-builds/cityborn-production-preview.apk",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "check-env": "node scripts/check-env.js",
    "postinstall": "cd ../.. && pnpm packages:build",
    "format": "biome check --write .",
    "check": "biome check .",
    "fullcheck": "pnpm typecheck && pnpm check"
  },
  "dependencies": {
    "@cityborn/api": "workspace:*",
    "@cityborn/client": "workspace:*",
    "@cityborn/contexts": "workspace:*",
    "@cityborn/design-system": "workspace:*",
    "@cityborn/utils": "workspace:*",
    "@expo/config-plugins": "^57.0.6",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/cli": "^20.1.3",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.15.10",
    "@react-navigation/elements": "^2.9.15",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.18.0",
    "@turf/turf": "^7.3.5",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "expo": "^57.0.0",
    "expo-apple-authentication": "~57.0.1",
    "expo-build-properties": "~57.0.7",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.7",
    "expo-dev-client": "~57.0.9",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-navigation-bar": "^57.0.2",
    "expo-router": "~57.0.8",
    "expo-secure-store": "^57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-updates": "~57.0.10",
    "expo-web-browser": "~57.0.2",
    "lucide-react-native": "^1.11.0",
    "nativewind": "5.0.0-preview.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-css": "^3.0.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "~4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "^15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.0",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/geojson": "^7946.0.16",
    "@types/react": "~19.2.14",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.2.1",
    "eslint-config-expo": "~57.0.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.3"
  },
  "private": true
}
