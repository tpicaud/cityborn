+import { Node, Project, ts, type Identifier, type ImportDeclaration, type ImportSpecifier, type SourceFile, type StringLiteral } from 'ts-morph'
+
+function hasReferences({ binding, declaration }: { binding: Identifier; declaration: ImportDeclaration }): boolean {
+  return binding.findReferencesAsNodes().some((reference) =>
+    reference.getStart() < declaration.getStart() || reference.getStart() >= declaration.getEnd()
+  )
+}
+
+function localBinding(specifier: ImportSpecifier): Identifier | undefined {
+  const binding: Identifier | StringLiteral = specifier.getAliasNode() ?? specifier.getNameNode()
+  return Node.isIdentifier(binding) ? binding : undefined
+}
+
+function usedImports(source: SourceFile): Set<string> {
+  const used: Set<string> = new Set()
+  source.getImportDeclarations().forEach((declaration) => {
+    const bindings: (Identifier | undefined)[] = [
+      declaration.getDefaultImport(),
+      declaration.getNamespaceImport(),
+      ...declaration.getNamedImports().map(localBinding),
+    ]
+    bindings.forEach((binding) => {
+      if (binding && hasReferences({ binding, declaration })) used.add(binding.getText())
+    })
+  })
+  return used
+}
+
+type PruneFlattenedImportsInput = {
+  original: string
+  compiled: string
+}
+
+export function pruneFlattenedImports({ original, compiled }: PruneFlattenedImportsInput): string {
+  const project: Project = new Project({
+    useInMemoryFileSystem: true,
+    compilerOptions: { noResolve: true, noLib: true, jsx: ts.JsxEmit.Preserve },
+  })
+  const source: SourceFile = project.createSourceFile('source.tsx', original)
+  const previouslyUsed: Set<string> = usedImports(source)
+  source.replaceWithText(compiled)
+  const stillUsed: Set<string> = usedImports(source)
+  const becameUnused: (binding: Identifier | undefined) => boolean = (binding) =>
+    !!binding && previouslyUsed.has(binding.getText()) && !stillUsed.has(binding.getText())
+
+  source.getImportDeclarations().forEach((declaration) => {
+    if (declaration.isTypeOnly()) return
+    let removed: boolean = false
+    declaration.getNamedImports().forEach((specifier) => {
+      if (!specifier.isTypeOnly() && becameUnused(localBinding(specifier))) {
+        specifier.remove()
+        removed = true
+      }
+    })
+    if (becameUnused(declaration.getDefaultImport())) {
+      declaration.removeDefaultImport()
+      removed = true
+    }
+    if (becameUnused(declaration.getNamespaceImport())) {
+      declaration.removeNamespaceImport()
+      removed = true
+    }
+    if (removed && !declaration.getDefaultImport() && !declaration.getNamespaceImport() && declaration.getNamedImports().length === 0) {
+      declaration.replaceWithText(`import ${JSON.stringify(declaration.getModuleSpecifierValue())};`)
+    }
+  })
+  return source.getFullText()
+}
