{
  "permissions": {
    "allow": ["Bash(git commit *)", "Bash(git push *)", "Bash(gh pr create *)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$(git branch --show-current)\" = main ] && git pull --ff-only --quiet 2>&1; true",
            "timeout": 30,
            "statusMessage": "Mise à jour de main"
          }
        ]
      }
    ]
  }
}
