{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false
    }
  },
  "globalEnv": [
    "NODE_ENV",
    "PORT",
    "AUTH_SECRET",
    "ADMIN_PASSWORD",
    "BACKEND_URL",
    "ADMIN_DASHBOARD_TOKEN",
    "NEXT_PUBLIC_GOOGLE_MAPS_API_KEY",
    "DIRECT_URL",
    "DATABASE_URL",
    "CORS_ORIGIN",
    "APP_ID",
    "GOOGLE_CLIENT_ID",
    "REDIS_URL",
    "UPSTASH_REDIS_REST_URL",
    "UPSTASH_REDIS_REST_TOKEN",
    "APP_VARIANT",
    "GOOGLE_MAPS_ANDROID_API_KEY",
    "GOOGLE_MAPS_IOS_API_KEY",
    "DOMAIN_NAME",
    "REST_BACKEND_URL"
  ]
}
