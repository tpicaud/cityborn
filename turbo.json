{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "test": {
      "inputs": [
        "src/**",
        "test/**",
        "jest.config.ts",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": ["coverage/**"]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false
    }
  },
  "globalEnv": [
    "NODE_ENV",
    "LOG_LEVEL",
    "AXIOM_TOKEN",
    "AXIOM_DATASET",
    "PORT",
    "FRONTEND_URL",
    "JWT_ACCESS_SECRET",
    "JWT_REFRESH_SECRET",
    "BREVO_API_KEY",
    "BREVO_SENDER_EMAIL",
    "BREVO_SENDER_NAME",
    "AUTH_SECRET",
    "ADMIN_PASSWORD",
    "BACKEND_URL",
    "ADMIN_DASHBOARD_TOKEN",
    "NEXT_PUBLIC_GOOGLE_MAPS_API_KEY",
    "NEXT_PUBLIC_GOOGLE_MAP_API_KEY",
    "NEXT_PUBLIC_GOOGLE_CLIENT_ID",
    "NEXT_PUBLIC_WEBSOCKET_BACKEND_URL",
    "DIRECT_URL",
    "DATABASE_URL",
    "CORS_ORIGIN",
    "APP_ID",
    "GOOGLE_CLIENT_ID",
    "REDIS_URL",
    "UPSTASH_REDIS_REST_URL",
    "UPSTASH_REDIS_REST_TOKEN",
    "APP_VARIANT",
    "GOOGLE_MAPS_ANDROID_API_KEY",
    "GOOGLE_MAPS_IOS_API_KEY",
    "EXPO_PUBLIC_REST_BACKEND_URL",
    "EXPO_PUBLIC_WEBSOCKET_BACKEND_URL",
    "EXPO_PUBLIC_GOOGLE_OAUTH_WEB_CLIENT_ID",
    "EXPO_PUBLIC_GOOGLE_OAUTH_IOS_CLIENT_ID",
    "DOMAIN_NAME",
    "REST_BACKEND_URL",
    "GITHUB_OUTPUT"
  ]
}
