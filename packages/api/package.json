{
  "name": "@cityborn/api",
  "version": "1.0.0",
  "main": "index.ts",
  "types": "index.ts",
  "type": "module",
  "author": "Tom Picaud",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "biome check --write .",
    "check": "biome check .",
    "generate:openapi:draft": "tsx scripts/generate-openapi-file.ts --mode=draft",
    "generate:openapi:release": "tsx scripts/generate-openapi-file.ts --mode=release",
    "check:compat": "tsx scripts/check-api-compat.ts",
    "check:deprecations": "tsx scripts/check-deprecations.ts",
    "test": "tsx --test openapi/compat/**/*.test.ts src/**/*.test.ts"
  },
  "dependencies": {
    "@ts-rest/core": "^3.52.1",
    "@ts-rest/open-api": "^3.52.1",
    "openapi3-ts": "^2.0.2",
    "typescript": "^6.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.19.4"
  }
}
