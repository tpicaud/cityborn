{
  "name": "@cityborn/api",
  "version": "1.0.0",
  "main": "index.ts",
  "types": "index.ts",
  "type": "module",
  "author": "Tom Picaud",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "biome check --write .",
    "check": "biome check .",
    "generate:openapi:draft": "tsx tools/generate-openapi-file.ts --mode=draft",
    "generate:openapi:release": "tsx tools/generate-openapi-file.ts --mode=release",
    "check:compat": "tsx tools/check-api-compat.ts",
    "check:deprecations": "tsx tools/check-deprecations.ts",
    "test": "tsx --test '**/*.test.ts'",
    "test:all": "pnpm test",
    "test:watch": "tsx --test --watch '**/*.test.ts'",
    "test:cov": "c8 --reporter=text --reporter=lcov tsx --test '**/*.test.ts'",
    "postinstall": "tsx tools/oasdiff/install.ts"
  },
  "dependencies": {
    "@anatine/zod-openapi": "^1.14.2",
    "@ts-rest/core": "^3.52.1",
    "@ts-rest/open-api": "^3.52.1",
    "openapi3-ts": "^2.0.2",
    "typescript": "^6.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.19.4",
    "c8": "^11.0.0"
  }
}
