{
  "name": "@cityborn/api",
  "version": "1.0.0",
  "main": "index.ts",
  "types": "index.ts",
  "type": "module",
  "author": "Tom Picaud",
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
