{
  "name": "@cityborn/client",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./admin": "./src/features/admin/index.ts",
    "./api": "./src/api/index.ts",
    "./auth": "./src/features/auth/index.ts",
    "./health": "./src/features/health/index.ts",
    "./session": "./src/features/session/index.ts",
    "./game": "./src/features/game/index.ts",
    "./profile": "./src/features/profile/index.ts",
    "./platform": "./src/platform/index.ts",
    "./ws": "./src/ws/index.ts"
  },
  "author": "Tom Picaud",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "biome check --write .",
    "lint": "biome check .",
    "test": "tsx --test '**/*.test.ts'",
    "test:all": "pnpm test",
    "test:watch": "tsx --test --watch '**/*.test.ts'",
    "test:cov": "c8 --reporter=text --reporter=lcov tsx --test '**/*.test.ts'",
    "check": "pnpm typecheck && pnpm lint"
  },
  "dependencies": {
    "@cityborn/api": "workspace:*",
    "@cityborn/core": "workspace:*",
    "typescript": "^6.0.3",
    "uuid": "^14.0.0",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.1",
    "@types/react": "~19.2.14",
    "react": "19.2.3",
    "react-hook-form": "^7.86.0",
    "socket.io-client": "^4.8.3"
  },
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "c8": "^11.0.0",
    "react": "19.2.5",
    "tsx": "^4.22.4"
  }
}
