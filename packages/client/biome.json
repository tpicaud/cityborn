{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "root": false,
  "extends": "//",
  "linter": {
    "domains": {
      "react": "recommended"
    },
    "rules": {
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": [
                  "next",
                  "next/**",
                  "expo",
                  "expo-*",
                  "expo-*/**",
                  "react-native",
                  "react-native-*",
                  "react-native-*/**",
                  "react-dom",
                  "react-dom/**",
                  "@cityborn/design-system",
                  "@cityborn/design-system/**"
                ],
                "message": "@cityborn/client doit rester agnostique de la plateforme et du rendu : déclarer un port dans src/platform et l'implémenter dans le lib/ de l'app."
              }
            ]
          }
        }
      }
    }
  }
}
